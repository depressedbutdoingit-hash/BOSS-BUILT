{
  "name": "boss-built",
  "version": "2.0.0",
  "private": true,
  "description": "Boss Built — AI full-stack engineer that builds, validates, and deploys complete applications",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" run dev",
    "dev:web": "pnpm --filter @boss/web dev",
    "dev:api": "pnpm --filter @boss/api dev",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @boss/db generate",
    "db:migrate": "pnpm --filter @boss/db migrate",
    "db:studio": "pnpm --filter @boss/db studio",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "prettier": "^3.8.1",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
